<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in game for checking the real Win32 path by hand: a plain Win32 window that can
       make itself windowed, borderless-fullscreen or a different size. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Self-contained so it runs without an installed .NET 10 runtime, like the app itself. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
