<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinForms tray app. `dotnet publish -c Release` makes one self-contained .exe for
       win-x64: it carries its own .NET runtime, so nothing needs installing first. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Roughly halves the exe for a small cost at start. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Drawn by tools/make-icon.ps1. -->
    <ApplicationIcon>GameBackdrop.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="GameBackdrop.ico" LogicalName="GameBackdrop.GameBackdrop.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameBackdrop.Core\GameBackdrop.Core.csproj" />
    <ProjectReference Include="..\GameBackdrop.Windows\GameBackdrop.Windows.csproj" />
  </ItemGroup>
</Project>
